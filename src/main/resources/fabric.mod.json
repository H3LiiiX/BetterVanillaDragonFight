{
  "schemaVersion": 1,
  "id": "bettervanilladragonfight",
  "version": "${version}",
  "name": "Better Vanilla Dragon Fight",
  "description": "A simple mod that scales the dragon fight according to the number of players in the end.",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/bettervanilladragonfight/icon.png",
  "environment": "*",
  "entrypoints": {
    "modmenu": [
      "com.h3liiix.bettervanilladragonfight.client.ModMenuIntegration"
    ],
    "main": [
      "com.h3liiix.bettervanilladragonfight.BetterVanillaDragonFight"
    ]
  },
  "mixins": [
    "bettervanilladragonfight.mixins.json",
    {
      "config": "bettervanilladragonfight.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
